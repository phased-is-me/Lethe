<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:importantForContentCapture="noExcludeDescendants"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="4dp">

        <ImageButton
            android:id="@+id/back"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_circle"
            android:contentDescription="@string/back"
            android:padding="11dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_back"
            android:tint="@color/ink" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/hide"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_circle"
            android:contentDescription="@string/continue_hidden"
            android:padding="11dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_eye_off"
            android:tint="@color/ink" />

        <ImageButton
            android:id="@+id/share"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_circle"
            android:contentDescription="@string/share"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_share"
            android:tint="@color/ink" />

        <ImageButton
            android:id="@+id/delete"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_circle"
            android:contentDescription="@string/delete"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_delete"
            android:tint="@color/ink" />
    </LinearLayout>

    <TextView
        android:id="@+id/meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="30dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="30dp"
        android:layout_marginBottom="10dp"
        android:textColor="@color/ink_soft"
        android:textSize="13sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_card_static"
        android:clipToOutline="true">

        <ScrollView
            android:id="@+id/scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="ifContentScrolls">

            <EditText
                android:id="@+id/editor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:fontFamily="@font/carlito"
                android:gravity="top|start"
                android:hint="@string/note_hint"
                android:imeOptions="flagNoExtractUi|flagNoPersonalizedLearning"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textCapSentences|textAutoCorrect"
                android:lineSpacingMultiplier="1.25"
                android:paddingStart="24dp"
                android:paddingTop="22dp"
                android:paddingEnd="24dp"
                android:paddingBottom="40dp"
                android:textColor="@color/ink"
                android:textColorHint="@color/ink_faint"
                android:textCursorDrawable="@drawable/cursor"
                android:textSize="20sp" />
        </ScrollView>
    </FrameLayout>
</LinearLayout>
