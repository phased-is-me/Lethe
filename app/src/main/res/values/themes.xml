<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Lethe" parent="android:Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_screen</item>
        <item name="android:windowSplashScreenBackground">@color/bg_top</item>
        <item name="android:statusBarColor" tools:ignore="NewApi">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:colorAccent">@color/ink</item>
        <item name="android:textColorHighlight">@color/selection</item>
    </style>

    <!-- Режим набора: чистое белое полотно -->
    <style name="Theme.Lethe.Write">
        <item name="android:windowBackground">@color/canvas</item>
        <item name="android:windowSplashScreenBackground">@color/canvas</item>
    </style>
</resources>
